@{
    ViewBag.Title = "Home";
}

<h2>Welcome to @ViewBag.AppName</h2>

<div style="margin: 20px 0; padding: 15px; background-color: #e7f3ff; border-left: 4px solid #2196F3;">
    <h3>Application Information</h3>
    <p><strong>Server Time:</strong> @ViewBag.ServerTime</p>
    <p><strong>Server Path:</strong> @ViewBag.ServerPath</p>
    <p><strong>Session Started:</strong> @ViewBag.SessionStartTime</p>
    <p><strong>Platform:</strong> .NET 8.0 on Linux (Container-ready)</p>
</div>

<div style="margin: 20px 0; padding: 15px; background-color: #d4edda; border-left: 4px solid #28a745;">
    <h3>Migration Complete! ✓</h3>
    <p>This application has been successfully migrated from .NET Framework 4.8 to .NET 8:</p>
    <ul>
        <li><strong>✓ System.Web removed</strong> - Now using ASP.NET Core abstractions (IHttpContextAccessor, IWebHostEnvironment)</li>
        <li><strong>✓ Configuration modernized</strong> - Web.config → appsettings.json with IConfiguration</li>
        <li><strong>✓ Dependency Injection</strong> - Services registered in Program.cs, injected via constructors</li>
        <li><strong>✓ Modern caching</strong> - System.Web.Caching → IMemoryCache</li>
        <li><strong>✓ Structured logging</strong> - ILogger with proper log levels</li>
        <li><strong>✓ SDK-style project</strong> - Simplified .csproj with PackageReferences</li>
        <li><strong>✓ Cross-platform</strong> - Runs on Linux, Windows, macOS</li>
        <li><strong>✓ Container-ready</strong> - Includes Dockerfile for OpenShift deployment</li>
    </ul>
</div>

<div style="margin: 20px 0;">
    <a asp-controller="Customer" asp-action="List" style="display: inline-block; padding: 10px 20px; background-color: #4CAF50; color: white; text-decoration: none; border-radius: 4px;">
        View Customers
    </a>
</div>
